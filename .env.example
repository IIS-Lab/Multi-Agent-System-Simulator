# Copy this file to .env for local development. Never commit .env.
# In production, set these as environment variables on the hosting platform.

# Shared login password (server-side only).
APP_PASSWORD=

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=
# Set to true when the app is served over HTTPS (production).
SESSION_COOKIE_SECURE=false

# OpenRouter (server-side only).
OPENROUTER_API_KEY=
# "openrouter" for real runs, "mock" for offline testing without API calls.
LLM_PROVIDER=openrouter
# Public URL of this app, e.g. https://<your-service>.onrender.com
# Used as the OpenRouter HTTP-Referer and for the keep-alive ping below.
APP_PUBLIC_URL=http://localhost:8000
# While a run is active, ping APP_PUBLIC_URL every 5 minutes so free hosts
# (e.g. Render Free) do not put the app to sleep in the middle of a run.
KEEP_ALIVE_WHILE_RUNNING=true

# Result storage: "github" (default) or "local" (writes to ./local_results).
STORAGE_BACKEND=github

# GitHub storage (server-side only).
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_RESULTS_DIR=results
